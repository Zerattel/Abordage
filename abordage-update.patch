@@ -0,0 +1,14 @@
+# Скопируй этот файл в .env (в корне проекта, рядом с package.json) и впиши настоящие значения.
+# Файл .env в git не попадает (см. .gitignore). Файл .env.example — шаблон, секретов в нём быть не должно.
+
+PORT=3000
+
+# Discord Developer Portal -> Applications -> твоё приложение -> OAuth2
+DISCORD_CLIENT_ID=вставь_client_id
+DISCORD_CLIENT_SECRET=вставь_client_secret
+# Должен ТОЧНО совпадать с одним из Redirects в настройках приложения Discord
+DISCORD_CALLBACK_URL=https://твой-домен/auth/discord/callback
+
+# Случайная строка от 32 символов. Сгенерировать:
+#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
+SESSION_SECRET=вставь_длинную_случайную_строку
